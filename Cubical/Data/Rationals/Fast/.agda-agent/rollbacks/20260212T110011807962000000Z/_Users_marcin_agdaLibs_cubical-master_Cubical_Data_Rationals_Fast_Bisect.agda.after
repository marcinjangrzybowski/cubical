private
 variable
  ℓ : Level

record DecidableCut : Type₁ where
 constructor decCut
 field
  P : ℙ ℚ
  P? : ∀ q → Dec (q ∈ P)
  P< : ∀ x y → x < y → x ∈ P → y ∈ P
  <P : ∀ x y → x < y → ¬ (y ∈ P) → ¬ (x ∈ P)

 -- A successful bisection returns an interval [l , h] contained in [a , b]
 -- with small width, such that l ∉ P and h ∈ P.
 BisectWitness : (a b : ℚ) (ε : ℚ₊) → Type
 BisectWitness a b ε =
  Σ-syntax ℚ (λ l →
  Σ-syntax ℚ (λ h →
      (a ≤ l)
    × (l < h)
    × (h ≤ b)
    × (h - l < fst ε)
    × (¬ (l ∈ P))
    × (h ∈ P)))

 -- One bisection step (split at midpoint). Kept separate to avoid `with`.
 -- We use an explicit fuel argument to satisfy termination checking.
 bisectStep : (n : ℕ) → (a b : ℚ) → a < b → (ε : ℚ₊) → Dec (BisectWitness a b ε)
 bisectStep zero a b a<b ε = ?
 bisectStep (suc n) a b a<b ε = step (P? a) (P? b)
  where
  step : Dec (a ∈ P) → Dec (b ∈ P) → Dec (BisectWitness a b ε)
  step (yes a∈P) (yes b∈P) =
    no λ { (l , h , a≤l , l<h , h≤b , h-l<ε , l∉P , h∈P) →
      case ≤→<⊎≡ a l a≤l of λ where
        (inl a≡l) → l∉P (subst (λ q → q ∈ P) a≡l a∈P)
        (inr a<l) → l∉P (P< a l a<l a∈P) }
  step (yes a∈P) (no  b∉P) =
    no λ { (l , h , a≤l , l<h , h≤b , h-l<ε , l∉P , h∈P) →
      case ≤→<⊎≡ a l a≤l of λ where
        (inl a≡l) → l∉P (subst (λ q → q ∈ P) a≡l a∈P)
        (inr a<l) → l∉P (P< a l a<l a∈P) }
  step (no  a∉P) (yes b∈P) = small (<Dec (b - a) (fst ε))
    where
    small : Dec (b - a < fst ε) → Dec (BisectWitness a b ε)
    small (yes b-a<ε) =
      yes (a , b , isRefl≤ a , a<b , isRefl≤ b , b-a<ε , a∉P , b∈P)
    small (no  ¬b-a<ε) = midCase (P? m)
      where
      half : ℚ
      half = [ pos 1 / 1+ 1 ]

      m : ℚ
      m = (a + b) · half

      midCase : Dec (m ∈ P) → Dec (BisectWitness a b ε)
      midCase (yes m∈P) = liftW (bisectStep n a m a<m ε)
        where
        a<m : a < m
        a<m = -<⁻¹ a m ?

        liftW : Dec (BisectWitness a m ε) → Dec (BisectWitness a b ε)
        liftW (yes (l , h , a≤l , l<h , h≤m , h-l<ε , l∉P , h∈P)) =
          yes (l , h , a≤l , l<h , h≤b , h-l<ε , l∉P , h∈P)
          where
          h≤b : h ≤ b
          h≤b = ?
        liftW (no nw) =
          no (λ w → nw (restrict w))
          where
          restrict : BisectWitness a b ε → BisectWitness a m ε
          restrict = ?
      midCase (no  m∉P) = ?
  step (no  a∉P) (no  b∉P) = ?

 -- Main entry point (implementation to be provided via binary bisection).
 bisect : (n : ℕ) → (a b : ℚ) → a < b → (ε : ℚ₊) → Dec (BisectWitness a b ε)
 bisect n a b a<b ε = bisectStep n a b a<b ε
